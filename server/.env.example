# Server environment configuration
# Copy this file to .env and fill in your own values.

# PostgreSQL connection — point this at your own Postgres server.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/space_alien_attack?schema=public"

# Individual connection parts (informational — DATABASE_URL above is what
# Prisma actually reads). Kept here so it's easy to see/update each piece
# and rebuild DATABASE_URL if your Postgres server's location changes.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=space_alien_attack

# JWT signing secret — replace with a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# HTTP server port
PORT=3000

# Comma-separated list of allowed CORS origins for the client dev server.
CORS_ORIGIN=http://localhost:5173
