generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  // Simple role flag for now — structured as a boolean rather than a
  // separate Admin table so it's trivial to extend to a proper role enum
  // later without a breaking schema change.
  isAdmin      Boolean      @default(false)
  // Banned users can no longer log in (enforced in /auth/login) and any
  // existing session is rejected on the next authenticated request.
  isBanned     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  stats        PlayerStats?
}

model PlayerStats {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  highScore   Int      @default(0)
  gamesPlayed Int      @default(0)
  updatedAt   DateTime @updatedAt
}
